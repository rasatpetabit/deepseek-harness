# Render all named parameters, then include this file inside nginx's http block.
# PUBLIC_AUTHORITY_REGEX is the regex-escaped PUBLIC_AUTHORITY (no scheme/port).
# LAN_CIDR is the approved client network, never the proxy's loopback network.
# EXTRA_CLIENT_ALLOW_LINES contains validated exact-client allow directives, or is empty.
map $http_host $dsh_host_allowed {
    default 0;
    ~^@PUBLIC_AUTHORITY_REGEX@$ 1;
}
map $http_origin $dsh_origin_allowed {
    default 0;
    "" 1;
    ~^https://@PUBLIC_AUTHORITY_REGEX@$ 1;
}
map $http_sec_fetch_site $dsh_cross_site {
    default 0;
    ~*^cross-site$ 1;
}
# Every upgrade, including WebSocket, requires the exact browser HTTPS origin.
map "$http_upgrade|$http_origin" $dsh_upgrade_allowed {
    default 0;
    ~^\| 1;
    ~^[^|]+\|https://@PUBLIC_AUTHORITY_REGEX@$ 1;
}
map $http_upgrade $dsh_connection_upgrade {
    default upgrade;
    "" close;
}
log_format dsh_query_free '$remote_addr $request_method $uri $status $body_bytes_sent';

server {
    listen @LISTEN_ADDRESS@:@HTTPS_PORT@ ssl default_server;
    server_name @PUBLIC_AUTHORITY@;
    ssl_certificate "@CERTIFICATE_PATH@";
    ssl_certificate_key "@KEY_PATH@";
    ssl_protocols TLSv1.2 TLSv1.3;

    allow @LAN_CIDR@;
@EXTRA_CLIENT_ALLOW_LINES@
    deny all;
    if ($dsh_host_allowed = 0) { return 403; }
    if ($dsh_origin_allowed = 0) { return 403; }
    if ($dsh_cross_site = 1) { return 403; }
    if ($dsh_upgrade_allowed = 0) { return 403; }

    access_log "@ACCESS_LOG_PATH@" dsh_query_free;
    # nginx error messages can contain full request URIs, including login tokens.
    error_log /dev/null;

    location / {
        proxy_pass http://@BACKEND_ADDRESS@:@BACKEND_PORT@;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cookie_flags ~ secure httponly samesite=strict;

        # An allowlist drops Forwarded, X-Real-IP and arbitrary X-Forwarded-*.
        # Cookie and public Host reach the existing signed-cookie verifier unchanged.
        proxy_pass_request_headers off;
        proxy_set_header Host $http_host;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Origin $http_origin;
        proxy_set_header Sec-Fetch-Site $http_sec_fetch_site;
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Content-Length $http_content_length;
        proxy_set_header Accept $http_accept;
        proxy_set_header Accept-Encoding $http_accept_encoding;
        proxy_set_header Accept-Language $http_accept_language;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cache-Control $http_cache_control;
        proxy_set_header If-None-Match $http_if_none_match;
        proxy_set_header If-Modified-Since $http_if_modified_since;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_set_header Last-Event-ID $http_last_event_id;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $dsh_connection_upgrade;
        proxy_set_header Sec-WebSocket-Key $http_sec_websocket_key;
        proxy_set_header Sec-WebSocket-Version $http_sec_websocket_version;
        proxy_set_header Sec-WebSocket-Protocol $http_sec_websocket_protocol;
        proxy_set_header Sec-WebSocket-Extensions $http_sec_websocket_extensions;
    }
}
