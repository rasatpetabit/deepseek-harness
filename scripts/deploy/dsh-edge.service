[Unit]
Description=DeepSeek Harness LAN-only HTTPS edge
After=network-online.target dsh.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/sbin/nginx -t -c /etc/dsh-edge/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/dsh-edge/nginx.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -c /etc/dsh-edge/nginx.conf -s reload
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/dsh-edge /run/dsh-edge
RuntimeDirectory=dsh-edge
LogsDirectory=dsh-edge

[Install]
WantedBy=multi-user.target
